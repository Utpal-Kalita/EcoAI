# Production Environment Configuration Template
# Copy this to .env and fill in the values

# ============================================
# API Keys (REQUIRED)
# ============================================

# Hugging Face Token for Llama 3.1
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=

# Cerebras API Key for accelerated inference
# Get from: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# ============================================
# Service Ports
# ============================================
FRONTEND_PORT=3000
BACKEND_PORT=3001
AI_SERVICE_PORT=8000

# ============================================
# Service URLs (Production)
# ============================================
# For production, update these to your actual domain/IP
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com
AI_SERVICE_URL=https://ai.your-domain.com

# ============================================
# Database Configuration (Optional)
# ============================================
# If you add a database in the future
# DATABASE_URL=postgresql://user:password@host:5432/ecoai

# ============================================
# Security Settings (Production)
# ============================================
# Generate a strong secret key for JWT tokens (if implementing auth)
# SECRET_KEY=your-secret-key-here

# CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ============================================
# Monitoring & Logging (Optional)
# ============================================
# Sentry DSN for error tracking
# SENTRY_DSN=

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# ============================================
# Performance Settings
# ============================================
# Redis URL (already included in docker-compose)
REDIS_URL=redis://redis:6379

# AI Model cache directory
MODEL_CACHE_DIR=/app/.cache

# Maximum request size (MB)
MAX_REQUEST_SIZE=10

# ============================================
# Feature Flags (Optional)
# ============================================
# Enable/disable features
ENABLE_ANALYTICS=false
ENABLE_PDF_EXPORT=true
ENABLE_AI_SIMULATION=true
