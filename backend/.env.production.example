# Production Environment Variables for Backend (Render)

# REQUIRED: AI Service URL
# Get this from your Render AI service deployment
# Example: https://ecoai-ai-service.onrender.com
AI_URL=https://your-ai-service-url.onrender.com

# OPTIONAL: Node environment
NODE_ENV=production

# OPTIONAL: Port (Render sets this automatically)
# PORT=3001
